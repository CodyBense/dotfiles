window-rule {
    open-maximized true
}

window-rule {
    match app-id="com.project.ghostty"
    match app-id="project"
    match app-id="Emacs"
    open-on-workspace "terminal"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id="zen"
    open-on-workspace "browser"
    open-focused true
}

window-rule {
    match app-id="com.files.ghostty"
    match app-id="files"
    match app-id="dolphin"
    match app-id="localsend"
    open-on-workspace "files"
    open-focused true
}

window-rule {
    match app-id="com.spotify.ghostty"
    match app-id="spotify"
    match app-id=r#"Spotify"#
    open-on-workspace "music"
    open-focused true
}

window-rule {
    match app-id="viber"
    open-on-workspace "chat"
}

window-rule {
    match title="Picture-in-Picture"
    open-floating true
    default-column-width { fixed 500; }
    default-window-height { fixed 300; }
    default-floating-position x=50 y=50 relative-to="top-right"
}
window-rule {
    // geometry-corner-radius 20
    clip-to-geometry true
}

