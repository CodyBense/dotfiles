#yay -S rustmon-git tlpui trashy ttf-material-icons-git

# Make some directories
echo "Creating directories"
if [ ! -d ~/workspaces/github.com/CodyBense ]; then
    mkdir -p ~/workspaces/github.com/CodyBense
fi

if [ ! -d ~/workspaces/Projects ]; then
    mkdir -p ~/workspaces/Projects
fi

if [ ! -d ~/HOME/Documents/Notes ]; then
    mkdir -p ~/Documents/Notes
fi

# Stow commands for dotfiles
echo "Using stow to source dotflies"
cd ~/dotfiles
dirs=(
    emoji
    git
    hypr
    lf
    nvim
    rofi
    scripts
    starship
    swaync
    tmux
    wallpapers
    waybar
    wlogout
