#!/usr/bin/env bash

change () { \
    ln -sf ~/.local/share/colors/$1/$1.css ~/.config/waybar/colors.css

    bash restart-waybar
}

selected () { \
    choice=$(echo -e "catppuccin-mocha\ngruvbox" | bemenu -c -l 5 -i -p "Change theme: ")
    case $choice in 
        "catppuccin-mocha") change "catppuccin-mocha" ;;
        "gruvbox") change "gruvbox" ;;
    esac
}

selected

